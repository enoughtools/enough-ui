---
import PopoverHeader from '../../src/astro/PopoverHeader.astro';
import PopoverTitle from '../../src/astro/PopoverTitle.astro';
import PopoverDescription from '../../src/astro/PopoverDescription.astro';
---
<div class="w-72 rounded-none border border-[var(--color-ink)] bg-[var(--color-surface)] p-4 shadow-[var(--shadow-palette)]">
  <PopoverHeader id="native-popover-header">
    <PopoverTitle id="native-popover-title">Share this canvas</PopoverTitle>
    <PopoverDescription id="native-popover-description">Invite your team to review the latest version.</PopoverDescription>
  </PopoverHeader>
</div>
