---
import DirectionProvider from '../../src/astro/DirectionProvider.astro';
---
<div class="flex flex-col gap-8 max-w-xl">
  <div>
    <h3 class="mb-2 font-sans text-sm font-semibold text-[var(--color-ink)]">
      Left to Right (LTR) - Native Astro
    </h3>
    <DirectionProvider
      direction="ltr"
      class="space-y-3 border border-[var(--color-ink)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-card)]"
    >
      <div class="font-sans text-xs uppercase text-[var(--color-accent)] font-semibold">
        dir="ltr"
      </div>
      <p class="font-sans text-sm leading-relaxed text-[var(--color-text-2)]">
        This container is rendered by the Native Astro DirectionProvider with <code class="bg-[var(--color-paper)] px-1 font-sans">dir="ltr"</code>. Text flows naturally from left to right.
      </p>
      <div class="flex gap-2">
        <span class="inline-flex border border-[var(--color-ink)] bg-[var(--color-ink)] px-3 py-1 font-sans text-xs font-semibold text-[var(--color-dark-text)]">
          Submit
        </span>
        <span class="inline-flex border border-[var(--color-ink)] bg-[var(--color-surface)] px-3 py-1 font-sans text-xs font-semibold text-[var(--color-text-2)]">
          Cancel
        </span>
      </div>
    </DirectionProvider>
  </div>

  <div>
    <h3 class="mb-2 font-sans text-sm font-semibold text-[var(--color-ink)]">
      Right to Left (RTL) - Native Astro
    </h3>
    <DirectionProvider
      direction="rtl"
      class="space-y-3 border border-[var(--color-ink)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-card)]"
    >
      <div class="font-sans text-xs uppercase text-[var(--color-accent)] font-semibold">
        dir="rtl"
      </div>
      <p class="font-sans text-sm leading-relaxed text-[var(--color-text-2)]">
        يتم عرض هذا المكون بواسطة موفر الاتجاه الأصلي في أسترو مع السمة <code class="bg-[var(--color-paper)] px-1 font-sans">dir="rtl"</code>. يتدفق النص وعناصر التحكم تلقائيًا من اليمين إلى اليسار.
      </p>
      <div class="flex gap-2">
        <span class="inline-flex border border-[var(--color-ink)] bg-[var(--color-ink)] px-3 py-1 font-sans text-xs font-semibold text-[var(--color-dark-text)]">
          إرسال
        </span>
        <span class="inline-flex border border-[var(--color-ink)] bg-[var(--color-surface)] px-3 py-1 font-sans text-xs font-semibold text-[var(--color-text-2)]">
          إلغاء
        </span>
      </div>
    </DirectionProvider>
  </div>
</div>
