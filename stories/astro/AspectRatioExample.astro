---
import AspectRatio from '../../src/astro/AspectRatio.astro';

const landscapeSvg =
  "data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%201600%20900%22%20width%3D%221600%22%20height%3D%22900%22%3E%3Crect%20width%3D%221600%22%20height%3D%22900%22%20fill%3D%22%2312151c%22%2F%3E%3Ccircle%20cx%3D%22800%22%20cy%3D%22450%22%20r%3D%22260%22%20fill%3D%22%233b4fe4%22%2F%3E%3Ctext%20x%3D%22800%22%20y%3D%22465%22%20fill%3D%22%23fafbfc%22%20font-family%3D%22sans-serif%22%20font-size%3D%2264%22%20font-weight%3D%22bold%22%20text-anchor%3D%22middle%22%3E16%3A9%20Aspect%20Ratio%3C%2Ftext%3E%3C%2Fsvg%3E";

const squareSvg =
  "data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20800%20800%22%20width%3D%22800%22%20height%3D%22800%22%3E%3Crect%20width%3D%22800%22%20height%3D%22800%22%20fill%3D%22%231c202b%22%2F%3E%3Crect%20x%3D%22160%22%20y%3D%22160%22%20width%3D%22480%22%20height%3D%22480%22%20fill%3D%22%233b4fe4%22%2F%3E%3Ctext%20x%3D%22400%22%20y%3D%22415%22%20fill%3D%22%23fafbfc%22%20font-family%3D%22sans-serif%22%20font-size%3D%2254%22%20font-weight%3D%22bold%22%20text-anchor%3D%22middle%22%3E1%3A1%20Square%3C%2Ftext%3E%3C%2Fsvg%3E";
---
<div class="flex flex-col gap-8 max-w-xl">
  <div>
    <h3 class="mb-2 font-sans text-sm font-semibold text-[var(--color-ink)]">
      16:9 Landscape Ratio (Native Astro)
    </h3>
    <div class="w-full overflow-hidden border border-[var(--color-ink)] shadow-[var(--shadow-card)]">
      <AspectRatio ratio={16 / 9}>
        <img
          src={landscapeSvg}
          alt="16:9 aspect ratio native Astro demonstration"
          class="h-full w-full object-cover"
        />
      </AspectRatio>
    </div>
  </div>

  <div>
    <h3 class="mb-2 font-sans text-sm font-semibold text-[var(--color-ink)]">
      1:1 Square Ratio (Native Astro)
    </h3>
    <div class="w-[280px] overflow-hidden border border-[var(--color-ink)] shadow-[var(--shadow-card)]">
      <AspectRatio ratio={1}>
        <img
          src={squareSvg}
          alt="1:1 square aspect ratio native Astro demonstration"
          class="h-full w-full object-cover"
        />
      </AspectRatio>
    </div>
  </div>
</div>
