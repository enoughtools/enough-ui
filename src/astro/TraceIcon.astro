---
import type { HTMLAttributes } from 'astro/types';
import { traceStyles } from '../lib/agent-ui.js';
import { cn } from '../lib/utils.js';
type Props = HTMLAttributes<'span'>;
const { class: className, ...attributes } = Astro.props;
---
<span data-slot="trace-icon" aria-hidden="true" class={cn(traceStyles.Icon, className)} {...attributes}><slot /></span>
