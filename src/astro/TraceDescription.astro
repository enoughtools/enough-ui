---
import type { HTMLAttributes } from 'astro/types';
import { traceStyles } from '../lib/agent-ui.js';
import { cn } from '../lib/utils.js';
type Props = HTMLAttributes<'span'>;
const { class: className, ...attributes } = Astro.props;
---
<span data-slot="trace-description" class={cn(traceStyles.Description, className)} {...attributes}><slot /></span>
